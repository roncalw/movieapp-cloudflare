/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "movieapp-cloudflare",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-20",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ALL_JOBS_PAUSED": "false",
		"CACHE_WARM_JOB_PAUSED": "false",
		"IMDB_JOB_PAUSED": "false",
		"JOB_NOTIFICATION_EMAIL_ENABLED": "true",
		"JOB_NOTIFICATION_EMAIL_FROM": "movieapp-jobs@codefest.com",
		"JOB_NOTIFICATION_EMAIL_TO": "roncalw@hotmail.com,admin@codefest.com",
		"JOB_SMTP_HOST": "codefest-com-smtp.dynu.com",
		"JOB_SMTP_PORT": "465",
		"JOB_SMTP_USERNAME": "movieapp-jobs@codefest.com",
		"MOVIE_LIST_JOB_PAUSED": "false",
		"TMDB_ENRICH_JOB_PAUSED": "false",
		"TMDB_NEW_MOVIE_DETAILS_JOB_PAUSED": "false",
		"TMDB_PRIMARY_JOB_PAUSED": "false"
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"limits": {
		"cpu_ms": 300000,
		"subrequests": 50000
	},
	/**
	 * These D1 entries describe the remote Cloudflare databases attached to this Worker.
	 *
	 * They are not the local D1 database files that Wrangler creates under:
	 *   .wrangler/state/v3/d1
	 *
	 * For local work, Wrangler creates the local database state automatically.
	 * You do not directly control the local database file name here.
	 *
	 * However, even for local migrations, you still have to specify the database
	 * in commands like:
	 *   wrangler d1 migrations apply movieapp-db --local
	 *
	 * Because Wrangler uses the database name in that command to decide which configured
	 * database entry you mean. That matters in projects that can have more than
	 * one D1 database, because Wrangler needs to know which migration set should
	 * be applied for that database.
	 *
	 * If a project had two D1 databases, the migration files would usually be split
	 * into different folders so each database has its own migration history.
	 *
	 * Example shape:
	 *   migrations/
	 *     movieapp-db/
	 *       0001_create_movie_list_schema.sql
	 *     analytics-db/
	 *       0001_create_analytics_tables.sql
	 *
	 * Then each migration command would point Wrangler at the correct database
	 * name, and Wrangler would apply the migration files for that database's
	 * migration folder.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "movieapp-db",
			"database_id": "bfd8c900-38f6-41e2-afcf-37772b5249a2"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "IMDB_RATING_QUEUE",
				"queue": "movieapp-imdb-rating-import-queue"
			},
			{
				"binding": "TMDB_ENRICHMENT_QUEUE",
				"queue": "movieapp-tmdb-enrichment-queue"
			},
			{
				"binding": "CACHE_WARM_QUEUE",
				"queue": "movieapp-cache-warm-queue"
			}
		],
		"consumers": [
			{
				"queue": "movieapp-imdb-rating-import-queue",
				"max_batch_size": 100,
				"max_batch_timeout": 10,
				"max_retries": 5
			},
			{
				"queue": "movieapp-tmdb-enrichment-queue",
				"max_batch_size": 1,
				"max_batch_timeout": 10,
				"max_retries": 5,
				"max_concurrency": 1
			},
			{
				"queue": "movieapp-cache-warm-queue",
				"max_batch_size": 1,
				"max_batch_timeout": 10,
				"max_retries": 5,
				"max_concurrency": 1
			}
		]
	},
	"triggers": {
		"crons": [
			/*
				NOTE on the asterisks: (for every n interval ...use a star followed by / (slash) and then a step value eg. every other day would be a star followed by /2)				
				0 1 * * 1
				| | | | |
				| | | | Sunday ... 1-Sunday, 2-Monday, 3-Tuesday, 4-Wednesday, 5-Thursday, 6-Friday, 7-Saturday
				| | | on a particular month (star for every month)
				| | on a particular day of the month 
				| 1:00 AM UTC
				minute 0
			*/
			// Saturday
				// IMDb Ratings Staging 
					// 9:00 PM EDT
						// 01:00 UTC Sunday
			"0 2 * * 6",
			//============================================
			// Saturday
				// TMDB Primary Staging 
					// 11:00 PM EDT
						// 03:00 UTC Sunday
			"0 3 * * 6",
			//============================================
			// Sunday
				// TMDB New Movie Details Staging 
					// 1:00 AM EDT
						// 05:00 UTC Sunday
			"0 5 * * 6",
			//============================================
			// Sunday
				// TMDB Watch Providers Staging 
					// 3:00 AM EDT
						// 07:00 UTC Sunday
			"0 7 * * 6",
			//============================================
			// Sunday
				// Movie List Production 
					// 8:00 AM EDT
						// 12:00 UTC Sunday
			"0 12 * * 6",
			//============================================
			// Sunday
				// Search Cache Warm All Genres
					// 9:00 AM EDT
						// 13:00 UTC Sunday
			"0 13 * * 6"
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
