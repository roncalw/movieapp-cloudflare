{
  "name": "movieapp-cloudflare",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "start": "wrangler dev",
    "test": "vitest --run",
    "cf-typegen": "wrangler types",
    "==============================================================CREATE-DDL-SQL-FILE============================================================================": "CREATE-DDL-SQL-FILE",
    "==============================================================CREATE DDL-SQL-FILE=============================================================================": "CREATE-DDL-SQL-FILE",
    "==============================================================CREATE DDL-SQL-FILE==============================================================================": "CREATE-DDL-SQL-FILE",
    "TO RUN THE FOLLOWING COMMAND--'npm run db:migration:create -- create_movie_list_schema'====file name is parameter to shortcut===========================": "CREATE-DDL-SQL-FILE",
    "db:migration:create": "wrangler d1 migrations create movieapp-db",
    "=================================================================RUN-LOCAL-DDL============================================================================": "RUN-LOCAL-DDL",
    "=================================================================RUN-LOCAL-DDL=============================================================================": "RUN-LOCAL-DDL",
    "=================================================================RUN-LOCAL-DDL==============================================================================": "RUN-LOCAL-DDL",
    "db:migrate:local": "wrangler d1 migrations apply movieapp-db --local",
    "db:seed:local": "wrangler d1 execute movieapp-db --local --file seed/seed-test-movies.sql",
    "db:query:local": "wrangler d1 execute movieapp-db --local --command \"SELECT * FROM movies ORDER BY id LIMIT 5;\"",
    "=================================================================RUN-REMOTE-DDL============================================================================": "REMOTE",
    "=================================================================RUN-REMOTE-DDL=============================================================================": "REMOTE",
    "=================================================================RUN-REMOTE-DDL==============================================================================": "REMOTE",
    "db:migrate:remote": "wrangler d1 migrations apply movieapp-db --remote",
    "db:seed:remote": "wrangler d1 execute movieapp-db --remote --file seed/seed-test-movies.sql",
    "db:query:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT * FROM movies ORDER BY id LIMIT 5;\"",
    "=================================================================DDL-RUN-HISTORY=====================================================================": "DDL-RUN-HISTORY",
    "=================================================================DDL-RUN-HISTORY======================================================================": "DDL-RUN-HISTORY",
    "=================================================================DDL-RUN-HISTORY=======================================================================": "DDL-RUN-HISTORY",
    "db:migrations:list:local": "wrangler d1 execute movieapp-db --local --command \"SELECT * FROM d1_migrations ORDER BY id;\"",
    "db:migrations:list:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT * FROM d1_migrations ORDER BY id;\""
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.84.0"
  }
}
