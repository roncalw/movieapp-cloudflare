{
  "name": "movieapp-cloudflare",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "start": "wrangler dev",
    "test": "vitest --run",
    "cf-typegen": "wrangler types",
    "=================================================================CREATE============================================================================": "CREATE",
    "=================================================================CREATE=============================================================================": "CREATE",
    "=================================================================CREATE==============================================================================": "CREATE",
    "TO RUN THE FOLLOWING COMMAND--'npm run db:migration:create -- create_test_movies_table'====file name is parameter to shortcut===========================": "CREATE",
    "db:migration:create": "wrangler d1 migrations create movieapp-test-db",
    "=================================================================LOCAL============================================================================": "LOCAL",
    "=================================================================LOCAL=============================================================================": "LOCAL",
    "=================================================================LOCAL==============================================================================": "LOCAL",
    "db:migrate:local": "wrangler d1 migrations apply movieapp-test-db --local",
    "db:seed:local": "wrangler d1 execute movieapp-test-db --local --file seed/seed-test-movies.sql",
    "db:query:local": "wrangler d1 execute movieapp-test-db --local --command \"SELECT * FROM movies ORDER BY id LIMIT 5;\"",
    "=================================================================REMOTE============================================================================": "REMOTE",
    "=================================================================REMOTE=============================================================================": "REMOTE",
    "=================================================================REMOTE==============================================================================": "REMOTE",
    "db:migrate:remote": "wrangler d1 migrations apply movieapp-test-db --remote",
    "db:seed:remote": "wrangler d1 execute movieapp-test-db --remote --file seed/seed-test-movies.sql",
    "db:query:remote": "wrangler d1 execute movieapp-test-db --remote --command \"SELECT * FROM movies ORDER BY id LIMIT 5;\"",
    "============================================================MIGRATIONS HISTORY=====================================================================": "MIGRATIONS_HISTORY",
    "============================================================MIGRATIONS HISTORY======================================================================": "MIGRATIONS_HISTORY",
    "============================================================MIGRATIONS HISTORY=======================================================================": "MIGRATIONS_HISTORY",
    "db:migrations:list:local": "wrangler d1 execute movieapp-test-db --local --command \"SELECT * FROM d1_migrations ORDER BY id;\"",
    "db:migrations:list:remote": "wrangler d1 execute movieapp-test-db --remote --command \"SELECT * FROM d1_migrations ORDER BY id;\""
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.84.0"
  }
}
