{
  "name": "movieapp-cloudflare",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "cf:login": "wrangler login",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "logtail": "npx wrangler tail",
    "start": "wrangler dev",
    "test": "vitest --run",
    "cf-typegen": "wrangler types",
    "==============================================================CREATE-DDL-SQL-FILE============================================================================": "CREATE-DDL-SQL-FILE",
    "==============================================================CREATE DDL-SQL-FILE=============================================================================": "CREATE-DDL-SQL-FILE",
    "==============================================================CREATE DDL-SQL-FILE==============================================================================": "CREATE-DDL-SQL-FILE",
    "TO RUN THE FOLLOWING COMMAND--'npm run db:migration:create -- create_movie_list_schema'====file name is parameter to shortcut===================================": "CREATE-DDL-SQL-FILE",
    "db:migration:create": "wrangler d1 migrations create movieapp-db",
    "SPACER": "1",
    "=SPACER": "2",
    "=================================LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==========================================================================": "RUN-LOCAL",
    "=================================LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL===========================================================================": "RUN-LOCAL",
    "=================================LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL==LOCAL============================================================================": "RUN-LOCAL",
    "=================================================================RUN-DDL-LOCAL============================================================================": "RUN-LOCAL-DDL",
    "=================================================================RUN-DDL-LOCAL=============================================================================": "RUN-LOCAL-DDL",
    "=================================================================RUN-DDL-LOCAL==============================================================================": "RUN-LOCAL-DDL",
    "db:migrate:local": "wrangler d1 migrations apply movieapp-db --local",
    "db:seed:local": "wrangler d1 execute movieapp-db --local --file seed/seed-test-movies.sql",
    "db:schema:local": "wrangler d1 execute movieapp-db --local --command \"SELECT type, name, tbl_name, sql FROM sqlite_master WHERE type IN ('table', 'index') ORDER BY type, name;\"",
    "=============================================================RUN-DDL-HISTORY-LOCAL=====================================================================": "RUN-DDL-HISTORY-LOCAL",
    "=============================================================RUN-DDL-HISTORY-LOCAL======================================================================": "RUN-DDL-HISTORY-LOCAL",
    "=============================================================RUN-DDL-HISTORY-LOCAL=======================================================================": "RUN-DDL-HISTORY-LOCAL",
    "db:migrations:list:local": "wrangler d1 execute movieapp-db --local --command \"SELECT * FROM d1_migrations ORDER BY id;\"",
    "============================================================RUN-SQL-ON-TABLES-LOCAL============================================================================": "RUN-SQL-ON-TABLES-LOCAL",
    "============================================================RUN-SQL-ON-TABLES-LOCAL=============================================================================": "RUN-SQL-ON-TABLES-LOCAL",
    "============================================================RUN-SQL-ON-TABLES-LOCAL==============================================================================": "RUN-SQL-ON-TABLES-LOCAL",
    "db:tables:local": "wrangler d1 execute movieapp-db --local --command \"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name;\"",
    "db:tmdb:count:local": "wrangler d1 execute movieapp-db --local --command \"SELECT COUNT(*) AS tmdb_count FROM tmdb_movies_staging;\"",
    "db:tmdb:preview:local": "wrangler d1 execute movieapp-db --local --command \"SELECT tmdb_id, title, release_date, popularity FROM tmdb_movies_staging ORDER BY release_date, tmdb_id LIMIT 50;\"",
    "==SPACER": "3",
    "===SPACER": "4",
    "=================================REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE=================================": "RUN-REMOTE",
    "=================================REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==================================": "RUN-REMOTE",
    "=================================REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE==REMOTE===================================": "RUN-REMOTE",
    "=================================================================RUN-DDL-REMOTE============================================================================": "REMOTE",
    "=================================================================RUN-DDL-REMOTE=============================================================================": "REMOTE",
    "=================================================================RUN-DDL-REMOTE==============================================================================": "REMOTE",
    "db:migrate:remote": "wrangler d1 migrations apply movieapp-db --remote",
    "db:seed:remote": "wrangler d1 execute movieapp-db --remote --file seed/seed-test-movies.sql",
    "db:schema:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT type, name, tbl_name, sql FROM sqlite_master WHERE type IN ('table', 'index') ORDER BY type, name;\"",
    "==============================================================RUN-DDL-HISTORY-REMOTE=====================================================================": "RUN-DDL-HISTORY-REMOTE",
    "==============================================================RUN-DDL-HISTORY-REMOTE======================================================================": "RUN-DDL-HISTORY-REMOTE",
    "==============================================================RUN-DDL-HISTORY-REMOTE=======================================================================": "RUN-DDL-HISTORY-REMOTE",
    "db:migrations:list:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT * FROM d1_migrations ORDER BY id;\"",
    "=============================================================RUN-SQL-ON-TABLES-REMOTE============================================================================": "RUN-SQL-ON-TABLES-REMOTE",
    "=============================================================RUN-SQL-ON-TABLES-REMOTE=============================================================================": "RUN-SQL-ON-TABLES-REMOTE",
    "=============================================================RUN-SQL-ON-TABLES-REMOTE==============================================================================": "RUN-SQL-ON-TABLES-REMOTE",
    "db:tables:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name;\"",
    "db:tmdb:count:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT COUNT(*) AS tmdb_count FROM tmdb_movies_staging;\"",
    "db:tmdb:preview:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT tmdb_id, title, release_date, popularity FROM tmdb_movies_staging ORDER BY release_date, tmdb_id LIMIT 50;\"",
    "====SPACER": "5",
    "=====SPACER": "6",
    "=================================CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE====================================================": "WARM-CLOUDFLARE-CDN-CACHE",
    "=================================CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE=====================================================": "WARM-CLOUDFLARE-CDN-CACHE",
    "=================================CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE======================================================": "WARM-CLOUDFLARE-CDN-CACHE",
    "db:cache:all": "node utils/warmCacheSearchUrls.mjs",
    "db:cache:horror": "node utils/warmCacheSearchUrls.mjs src/cache/data/cacheGenreHorrorURL.json",
    "db:cache:default-popularity": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years'",
    "db:cache:comedy-g": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&certifications=G&genreIds=35'",
    "db:cache:comedy-g-pg-r": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&certifications=G,PG,R&genreIds=35'",
    "db:cache:vote5000-horror": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&genreIds=27&minImdbVotes=5000&sort=imdb'",
    "db:cache:vote10000-horror": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&genreIds=27&minImdbVotes=10000&sort=imdb'",
    "db:cache:vote20000-horror": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&genreIds=27&minImdbVotes=20000&sort=imdb'",
    "db:cache:vote25000-horror-flatrate": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&genreIds=27&watchMonetizationTypes=flatrate&minImdbVotes=25000&sort=imdb'",
    "db:cache:vote5000-horror-scifi": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&genreIds=27,878&minImdbVotes=5000&sort=imdb'",
    "db:cache:netflix-prime": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&providerIds=8,9'",
    "db:cache:vote5000-horror-netflix-prime": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&genreIds=27&providerIds=8,9&minImdbVotes=5000&sort=imdb'",
    "db:cache:vote10000-action-thriller-netflix-prime": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&genreIds=28,53&providerIds=8,9&minImdbVotes=10000&sort=imdb'"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.84.0"
  }
}
