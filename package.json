{
  "name": "movieapp-cloudflare",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "cf:login": "wrangler login",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "logtail": "npx wrangler tail",
    "start": "wrangler dev",
    "test": "vitest --run",
    "cf-typegen": "wrangler types",
    "==============================================================CREATE-DDL-SQL-FILE============================================================================": "CREATE-DDL-SQL-FILE",
    "==============================================================CREATE DDL-SQL-FILE=============================================================================": "CREATE-DDL-SQL-FILE",
    "==============================================================CREATE DDL-SQL-FILE==============================================================================": "CREATE-DDL-SQL-FILE",
    "TO RUN THE FOLLOWING COMMAND--'npm run db:migration:create -- create_movie_list_schema'====file name is parameter to shortcut===================================": "CREATE-DDL-SQL-FILE",
    "db:migration:create": "wrangler d1 migrations create movieapp-db",
    "SPACER": "1",
    "=SPACER": "2",
    "=================================================================RUN-DDL-REMOTE============================================================================": "REMOTE",
    "=================================================================RUN-DDL-REMOTE=============================================================================": "REMOTE",
    "=================================================================RUN-DDL-REMOTE==============================================================================": "REMOTE",
    "db:migrate:remote": "wrangler d1 migrations apply movieapp-db --remote",
    "db:seed:remote": "wrangler d1 execute movieapp-db --remote --file seed/seed-test-movies.sql",
    "db:schema:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT type, name, tbl_name, sql FROM sqlite_master WHERE type IN ('table', 'index') ORDER BY type, name;\"",
    "==============================================================RUN-DDL-HISTORY-REMOTE=====================================================================": "RUN-DDL-HISTORY-REMOTE",
    "==============================================================RUN-DDL-HISTORY-REMOTE======================================================================": "RUN-DDL-HISTORY-REMOTE",
    "==============================================================RUN-DDL-HISTORY-REMOTE=======================================================================": "RUN-DDL-HISTORY-REMOTE",
    "db:migrations:list:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT * FROM d1_migrations ORDER BY id;\"",
    "=============================================================RUN-SQL-ON-TABLES-REMOTE============================================================================": "RUN-SQL-ON-TABLES-REMOTE",
    "=============================================================RUN-SQL-ON-TABLES-REMOTE=============================================================================": "RUN-SQL-ON-TABLES-REMOTE",
    "=============================================================RUN-SQL-ON-TABLES-REMOTE==============================================================================": "RUN-SQL-ON-TABLES-REMOTE",
    "db:tables:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name;\"",
    "db:tmdb:count:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT COUNT(*) AS tmdb_count FROM tmdb_movies_staging;\"",
    "db:tmdb:preview:remote": "wrangler d1 execute movieapp-db --remote --command \"SELECT tmdb_id, title, release_date, popularity FROM tmdb_movies_staging ORDER BY release_date, tmdb_id LIMIT 50;\"",
    "====SPACER": "5",
    "=====SPACER": "6",
    "=================================PROD-JOBS==PROD-JOBS==PROD-JOBS==PROD-JOBS==========================================================================": "RUN-PRODUCTION-JOBS",
    "=================================PROD-JOBS==PROD-JOBS==PROD-JOBS==PROD-JOBS===========================================================================": "RUN-PRODUCTION-JOBS",
    "=================================PROD-JOBS==PROD-JOBS==PROD-JOBS==PROD-JOBS============================================================================": "RUN-PRODUCTION-JOBS",
    "FIRST============================================================================IMDB================================================================": "FIRST",
    "=================================================================================IMDB=============================================================": "IMDB",
    "job:imdb": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/imdb-ratings/enqueue-manual\" | jq",
    "monitor:imdb": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=imdb-ratings&limit=1\" | jq",
    "SECOND========================================================================NEW-PRIMARY====================================================================": "SECOND",
    "==============================================================================NEW-PRIMARY==========================================================": "NEW-PRIMARY",
    "job:np": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/tmdb/new-primary-manual\" | jq",
    "monitor:np": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=tmdb-primary&limit=1\" | jq",
    "THIRD======================================================================NEW-PRIMARY-DETAILS======================================================================": "THIRD",
    "===========================================================================NEW-PRIMARY-DETAILS======================================================": "NEW-PRIMARY-DETAILS",
    "job:npd": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/tmdb/new-movie-details-manual\" | jq",
    "monitor:npd": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=tmdb-new-movie-details&limit=1\" | jq",
    "FIFTH========================================================================WATCH-PROVIDERS====================================================================": "FIFTH",
    "=============================================================================WATCH-PROVIDERS========================================================": "WATCH-PROVIDERS",
    "job:wpr": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/tmdb/provider-refresh-manual\" | jq",
    "monitor:wpr": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=tmdb-provider-refresh&limit=1\" | jq",
		"POPULARITY====================================================================": "POPULARITY",
		"job:popularity": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/tmdb/popularity-refresh-manual\" | jq",
		"monitor:popularity": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=tmdb-popularity-refresh&limit=1\" | jq",
    "LANGUAGE-LOOKUP===============================================================": "LANGUAGE-LOOKUP",
    "job:language-lookup": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/tmdb/language-lookup-refresh-manual\" | jq",
    "monitor:language-lookup": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=tmdb-language-lookup-refresh&limit=1\" | jq",
    "ORIGINAL-LANGUAGE-BACKFILL====================================================": "ORIGINAL-LANGUAGE-BACKFILL",
		"job:language-backfill": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/tmdb/original-language-backfill-manual\" | jq",
		"monitor:language-backfill": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=tmdb-original-language-backfill&limit=1\" | jq",
		"job:language-residual": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/tmdb/original-language-residual-manual\" | jq",
		"monitor:language-residual": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=tmdb-original-language-residual&limit=1\" | jq",
    "SIXTH===========================================================================MOVIE-LIST=================================================================": "SIXTH",
    "================================================================================MOVIE-LIST==========================================================": "MOVIE-LIST",
    "job:ml": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/movie-list/rebuild-manual\" | jq",
    "monitor:ml": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=movie-list-build&limit=1\" | jq",
    "SEVENTH==========================================================================CACHE==================================================================": "SEVENTH",
    "=================================================================================CACHE===============================================================": "CACHE",
    "job:cache": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/cache/search/warm-manual\" | jq",
    "monitor:cache": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=cache-warm-search&limit=1\" | jq",
		"job:weekly-validation": "curl -s -X POST -H \"Authorization: Bearer $ADMIN_IMPORT_TOKEN\" \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/weekly-validation-manual\" | jq",
		"monitor:weekly-validation": "curl -s \"https://movieapp-cloudflare.carlo-roncallo.workers.dev/admin/import/job-runs?jobName=weekly-import-validation&limit=1\" | jq",
    "======SPACER": "7",
    "=================================CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE====================================================": "WARM-CLOUDFLARE-CDN-CACHE",
    "=================================CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE=====================================================": "WARM-CLOUDFLARE-CDN-CACHE",
    "=================================CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE==CDN-CACHE======================================================": "WARM-CLOUDFLARE-CDN-CACHE",
    "db:cache:all": "node utils/warmCacheSearchUrls.mjs",
    "db:cache:horror": "node utils/warmCacheSearchUrls.mjs src/cache/data/cacheGenreHorrorURL.json",
    "db:cache:default-popularity": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years'",
    "db:cache:vote25000-horror-flatrate": "curl -s -D - -o /dev/null -w 'time_total=%{time_total}\\n' 'https://movieapp-cloudflare.carlo-roncallo.workers.dev/movies/search?pageSize=20&datePreset=last5years&genreIds=27&watchMonetizationTypes=flatrate&minImdbVotes=25000&sort=imdb'",
    "sync:cron": "node scripts/syncScheduledCrons.mjs",
    "pretest": "npm run sync:cron"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.84.0"
  }
}
